# ─────────────────────────────────────────────────────────────────────────────
# Visacredit XIXA — environnement de déploiement UNIQUE. Remplissez une copie et
# collez-la dans l'onglet *Environment* du service Compose, dans Dokploy.
# NE JAMAIS versionner la version remplie.
#
# « FILL » = propre au déploiement. Il n'y a rien d'autre à configurer :
# la base est créée par le compose, et le frontend est publié sur le port 8090.
#
# Ce qui N'EST PAS ici, volontairement :
#   • DATABASE_URL — construite dans docker-compose.prod.yml à partir de
#     MYSQL_PASSWORD ci-dessous, l'hôte étant le service `db`. Rien à recopier.
#   • toute variable pour le mobile — l'application est autonome (SQLite
#     embarquée) et ne joint aucun serveur.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (MariaDB embarquée dans le compose) ──
# Le mot de passe ne doit contenir ni @ ni : ni / — docker-entrypoint.sh découpe
# l'URL de connexion à la main. Des lettres et des chiffres suffisent.
MYSQL_PASSWORD=FILL_MOT_DE_PASSE
MYSQL_ROOT_PASSWORD=FILL_AUTRE_MOT_DE_PASSE

# ── Noyau Symfony ──
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=FILL_HEX_ALEATOIRE          # php -r "echo bin2hex(random_bytes(16));"

# ── URL publique ──
# Sert au routeur Symfony à construire des URL absolues hors requête HTTP.
# Adresse du frontend, port compris. À reprendre le jour où un domaine arrive.
DEFAULT_URI=http://13.140.134.229:8090

# ── CORS ──
# Inutilisé ici : le navigateur ne parle qu'au frontend, qui relaie `/api` au
# backend par le réseau interne. Une seule origine, donc aucune requête
# inter-origines. Laisser tel quel.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# ── JWT (Lexik) — paire de clés générée au démarrage à partir de la passphrase ──
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=FILL_HEX_ALEATOIRE

# ── KkiaPay ──
# Les quatre variables sont OBLIGATOIRES, y compris le secret de webhook : elles
# sont injectées par autowiring et le conteneur Symfony refuse de démarrer si
# l'une manque. Mettez une valeur bidon plutôt que de laisser la ligne absente.
# Les valeurs réelles sont dans votre backend/.env local.
KKIAPAY_PUBLIC_KEY=FILL
KKIAPAY_PRIVATE_KEY=FILL
KKIAPAY_WEBHOOK_SECRET=FILL
KKIAPAY_SANDBOX=1
KKIAPAY_API_URL=https://api.kkiapay.me/api/v1

# ── FedaPay ──
# Même remarque : FEDAPAY_WEBHOOK_SECRET est obligatoire.
FEDAPAY_PUBLIC_KEY=FILL
FEDAPAY_SECRET_KEY=FILL
FEDAPAY_WEBHOOK_SECRET=FILL
FEDAPAY_SANDBOX=1

# ── Interface web ──
# Lien de téléchargement de l'APK, si vous en distribuez un. Figée dans le
# bundle AU BUILD : après modification, relancer un *Deploy*. Tant qu'elle est
# vide, le bouton de la page d'accueil affiche « lien bientôt disponible ».
NEXT_PUBLIC_LIEN_APK=
