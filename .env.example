# ─────────────────────────────────────────────────────────────────────────────
# Visacredit XIXA — environnement de déploiement UNIQUE. Remplissez une copie et
# collez-la dans l'onglet *Environment* du service Compose, dans Dokploy.
# Ces valeurs sont injectées dans le conteneur BACKEND et remplacent
# backend/.env. NE JAMAIS versionner la version remplie.
#
# « FILL » = propre au déploiement.
#
# Le frontend n'a besoin de presque rien ici : le navigateur appelle `/api` en
# relatif, relayé au backend par le réseau interne (frontend/next.config.ts).
# Seule NEXT_PUBLIC_LIEN_APK, tout en bas, le concerne.
# ─────────────────────────────────────────────────────────────────────────────

# ── Noyau Symfony ──
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=FILL_HEX_ALEATOIRE          # php -r "echo bin2hex(random_bytes(16));"

# ── Base de données (MySQL gérée par Dokploy — utiliser son hôte INTERNE) ──
# Format : mysql://USER:PASSWORD@HOST:3306/DBNAME?serverVersion=8.0&charset=utf8mb4
# NE PAS réutiliser la base `waofin` d'epargne-africaVR : créez-en une nouvelle.
DATABASE_URL="mysql://FILL_USER:FILL_PASSWORD@FILL_MYSQL_HOST:3306/FILL_DB?serverVersion=8.0&charset=utf8mb4"

# ── URL publique ──
# Sert au routeur Symfony à construire des URL absolues hors requête HTTP.
DEFAULT_URI=https://visacredit.waofin.co

# ── CORS ──
# Origine unique via le proxy du frontend → le CORS ne sert pas. L'application
# mobile n'envoie pas d'en-tête Origin, elle n'est pas concernée non plus.
# À ne changer que si un jour une page appelle l'API depuis un autre domaine.
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$

# ── JWT (Lexik) — paire de clés générée au démarrage à partir de la passphrase ──
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=FILL_HEX_ALEATOIRE

# ── KkiaPay ──
# Les quatre variables sont OBLIGATOIRES, y compris le secret de webhook : elles
# sont injectées par autowiring et le conteneur Symfony refuse de démarrer si
# l'une manque. Mettez une valeur bidon plutôt que de laisser la ligne absente.
KKIAPAY_PUBLIC_KEY=FILL
KKIAPAY_PRIVATE_KEY=FILL
KKIAPAY_WEBHOOK_SECRET=FILL
KKIAPAY_SANDBOX=1
KKIAPAY_API_URL=https://api.kkiapay.me/api/v1

# ── FedaPay ──
# Même remarque : FEDAPAY_WEBHOOK_SECRET est obligatoire.
FEDAPAY_PUBLIC_KEY=FILL
FEDAPAY_SECRET_KEY=FILL
FEDAPAY_WEBHOOK_SECRET=FILL
FEDAPAY_SANDBOX=1

# ── Interface web (service `frontend`) ──
# Lien de téléchargement de l'APK émis par EAS (voir DEPLOIEMENT.md § 7).
# Figée dans le bundle AU BUILD : après modification, relancer un *Deploy*, un
# redémarrage ne suffirait pas. Tant qu'elle est vide, le bouton de la page
# d'accueil affiche « lien bientôt disponible ».
NEXT_PUBLIC_LIEN_APK=
